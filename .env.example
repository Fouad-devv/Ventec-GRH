# ── App Database – Neon PostgreSQL (Spring Boot) ────────────────────────────
DB_URL=jdbc:postgresql://<host>/neondb?sslmode=require&channel_binding=require
DB_USERNAME=neondb_owner
DB_PASSWORD=

# ── Keycloak Database – Neon PostgreSQL (separate project) ───────────────────
KC_DB_URL=jdbc:postgresql://<host>/neondb?sslmode=require&options=-c%20idle_in_transaction_session_timeout%3D0
KC_DB_USERNAME=neondb_owner
KC_DB_PASSWORD=

# Keycloak admin
KC_USERNAME=
KC_PWD=

KC_HOSTNAME=localhost
APP_LOGIN_URL=https://localhost


# Keycloak – shared by backend and frontend
KEYCLOAK_PUBLIC_URL=https://localhost:8443
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=

# Backend
CORS_ALLOWED_ORIGINS=https://localhost,http://localhost:5173

# Mail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Inbound Email — IMAP polling
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
EMAIL_POLL_ENABLED=false
EMAIL_POLL_INTERVAL_MS=300000

# Initial admin account
INIT_ADMIN_EMAIL=
INIT_ADMIN_FIRSTNAME=
INIT_ADMIN_LASTNAME=
INIT_ADMIN_PASSWORD=
INIT_ADMIN_DEPARTMENT=

# AI service — Groq
GROQ_API_KEY=
GROQ_API_KEY2=
GROQ_API_KEY3=
GROQ_API_KEY4=
GROQ_API_KEY5=
GROQ_API_KEY6=

# AI service — Gemini
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
GEMINI_API_KEY5=
GEMINI_API_KEY6=

# AI service — SambaNova
SAMBANOVA_API_KEY=
SAMBANOVA_API_KEY2=
SAMBANOVA_API_KEY3=
SAMBANOVA_API_KEY4=
SAMBANOVA_API_KEY5=
SAMBANOVA_API_KEY6=

# Frontend (Vite)
VITE_KEYCLOAK_URL=https://localhost:8443
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=
VITE_API_URL=https://localhost/api
