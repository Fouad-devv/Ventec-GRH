FROM quay.io/keycloak/keycloak:latest

# Custom login theme
COPY keycloak-theme/ventec-grh /opt/keycloak/themes/ventec-grh

# Realm import (skipped automatically if realm already exists in DB)
COPY realm-export.json /opt/keycloak/data/import/realm-export.json

# Pre-build optimized server for production mode (bakes db=postgres into image)
RUN /opt/keycloak/bin/kc.sh build --db=postgres
